---
// The VigilOps mark. Kept in one place so the nav, footer and dashboard can't drift apart.
// The files in public/ (favicon.svg, the PNGs, the .ico) carry the same geometry.
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 120 120" aria-hidden="true" focusable="false">
  <rect x="4" y="4" width="112" height="112" rx="28" fill="#33D6B0"></rect>
  <path
    d="M32 36 L58 76 L88 32"
    fill="none"
    stroke="#0B0F14"
    stroke-width="13"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="82" cy="57" r="7" fill="#0B0F14"></circle>
</svg>
