---
import { site, company } from '../data/site';

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/#product', label: 'Features' },
      { href: '/pricing/', label: 'Pricing' },
      { href: site.releases, label: 'Changelog' },
      { href: '/docs/install/', label: 'Install' },
    ],
  },
  {
    title: 'Docs',
    links: [
      { href: '/docs/', label: 'What is VigilOps?' },
      { href: '/docs/guides/backups/', label: 'Backups' },
      { href: '/docs/reference/cli/', label: 'CLI reference' },
      { href: '/docs/reference/configuration/', label: 'Configuration' },
    ],
  },
  {
    title: 'Community',
    links: [
      { href: site.github, label: 'GitHub' },
      { href: site.issues, label: 'Report an issue' },
      { href: '/docs/contributing/develop/', label: 'Contributing' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: `mailto:${company.contactEmail}`, label: 'Contact' },
      { href: '/status/', label: 'Cloud status' },
      { href: '/terms/', label: 'Terms' },
      { href: '/privacy/', label: 'Privacy' },
      { href: '/refunds/', label: 'Refunds' },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <a class="logo" href="/">
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#0d7a6f" />
            <path d="M8 10.5 16 23l8-12.5" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="16" cy="8.5" r="2" fill="#8fe3d2" />
          </svg>
          VigilOps
        </a>
        <p>Open-source ops agent for Docker servers.</p>
      </div>
      {columns.map((c) => (
        <nav aria-label={c.title}>
          <h3>{c.title}</h3>
          <ul>
            {c.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="bottom">
      <span>© {new Date().getFullYear()} VigilOps. Released under the MIT license.</span>
      <span>vigilops.cloud</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--bg-soft); border-top: 1px solid var(--line); padding: 56px 0 28px; font-size: 14px; }
  .top { display: grid; gap: 32px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .brand { grid-column: 1 / -1; }
  .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; text-decoration: none; }
  .brand p { color: var(--muted); margin-top: 12px; max-width: 260px; }
  h3 { font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 14px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  li a { color: var(--muted); text-decoration: none; }
  li a:hover { color: var(--ink); }
  .bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--muted);
  }
  @media (min-width: 900px) {
    .top { grid-template-columns: 1.6fr repeat(4, minmax(0, 1fr)); }
    .brand { grid-column: auto; }
  }
</style>
