---
import Marketing from '../../layouts/Marketing.astro';
import { company } from '../../data/site';
---

<Marketing title="Thank you · VigilOps" description="Your VigilOps subscription is being set up.">
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
  <section class="done">
    <div class="container narrow">
      <div class="mark" aria-hidden="true">
        <svg viewBox="0 0 52 52" width="56" height="56"><circle cx="26" cy="26" r="24" /><path d="M15 27l7 7 15-16" /></svg>
      </div>
      <h1>Thanks for subscribing.</h1>
      <p class="lead">
        Your payment is being confirmed. You'll get a receipt by email from our payment provider, Bachs, and we'll email you
        within one business day to set up your support and early access.
      </p>
      <div class="next">
        <h2>While you wait</h2>
        <ol>
          <li><a href="/docs/install/">Install VigilOps</a> on your server if you haven't yet.</li>
          <li><a href="/docs/guides/backups/">Schedule your first database backup.</a></li>
          <li>Reply to our email with how many servers you run and what's on them.</li>
        </ol>
      </div>
      <p class="help">Questions about billing? Email <a href={`mailto:${company.supportEmail}`}>{company.supportEmail}</a>.</p>
    </div>
  </section>
</Marketing>

<style>
  .done { padding: 88px 0 104px; }
  .narrow { max-width: 680px; }
  .mark svg { fill: none; stroke: var(--brand); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .mark circle { stroke-dasharray: 151; stroke-dashoffset: 151; animation: draw .7s ease forwards; }
  .mark path { stroke-dasharray: 40; stroke-dashoffset: 40; animation: draw .4s .55s ease forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  h1 { font-size: clamp(32px, 5vw, 48px); margin-top: 24px; }
  .lead { font-size: 18px; color: var(--ink-2); margin-top: 16px; }
  .next { margin-top: 40px; padding: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-soft); }
  .next h2 { font-size: 17px; }
  .next ol { margin: 12px 0 0; padding-left: 20px; display: grid; gap: 8px; color: var(--ink-2); }
  a { color: var(--brand); }
  .help { margin-top: 28px; color: var(--muted); }
</style>
