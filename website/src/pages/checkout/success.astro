---
import Marketing from '../../layouts/Marketing.astro';
import { company } from '../../data/site';
---

<Marketing title="Thank you · VigilOps" description="Your VigilOps subscription is being set up.">
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
  <section class="done">
    <div class="container narrow">
      <div class="mark" aria-hidden="true">
        <svg viewBox="0 0 52 52" width="56" height="56"><circle cx="26" cy="26" r="24" /><path d="M15 27l7 7 15-16" /></svg>
      </div>
      <h1>Thanks for subscribing.</h1>
      <p class="lead">
        Your payment is being confirmed, and you'll get a receipt by email from our payment provider, Bachs.
      </p>
      <div class="next">
        <div data-waiting>
          <h2>Setting up your plan<span class="dots" aria-hidden="true"></span></h2>
          <p class="muted-note">This takes a few seconds. You'll go to your dashboard automatically.</p>
        </div>

        <div data-signin hidden>
          <h2>Sign in to finish setup</h2>
          <p class="muted-note">Use a GitHub account that has the email you just paid with, as a verified email.</p>
          <a class="btn btn-primary go" href="/login/?next=/app/">Sign in with GitHub</a>
        </div>

        <div data-slow hidden>
          <h2>Your plan is taking a moment</h2>
          <p class="muted-note">
            Payments usually appear within a minute. Open your dashboard and refresh; if it still shows no plan in a few
            minutes, email us and we'll sort it out.
          </p>
          <a class="btn btn-primary go" href="/app/">Go to dashboard</a>
        </div>
      </div>
      <p class="help">Questions about billing? Email <a href={`mailto:${company.supportEmail}`}>{company.supportEmail}</a>.</p>
    </div>
  </section>

  <script>
    // Wait for the payment to register, then go straight to the dashboard
    const show = (name: string) =>
      document.querySelectorAll<HTMLElement>('[data-waiting],[data-signin],[data-slow]').forEach((el) => {
        el.hidden = el.dataset[name] === undefined;
      });

    let tries = 0;
    async function poll() {
      tries++;
      try {
        const res = await fetch('/api/me');
        if (res.status === 401) return show('signin');
        const me = await res.json();
        if (me.plan) return location.replace('/app/');
      } catch {
        /* keep trying */
      }
      if (tries >= 20) return show('slow');
      setTimeout(poll, 3000);
    }
    poll();
  </script>
</Marketing>

<style>
  .done { padding: 88px 0 104px; }
  .narrow { max-width: 680px; }
  .mark svg { fill: none; stroke: var(--brand); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .mark circle { stroke-dasharray: 151; stroke-dashoffset: 151; animation: draw .7s ease forwards; }
  .mark path { stroke-dasharray: 40; stroke-dashoffset: 40; animation: draw .4s .55s ease forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  h1 { font-size: clamp(32px, 5vw, 48px); margin-top: 24px; }
  .lead { font-size: 18px; color: var(--ink-2); margin-top: 16px; }
  .next { margin-top: 40px; padding: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-soft); }
  .next h2 { font-size: 17px; }
  .next ol { margin: 12px 0 0; padding-left: 20px; display: grid; gap: 8px; color: var(--ink-2); }
  a { color: var(--brand); }
  .help { margin-top: 28px; color: var(--muted); }
  .muted-note { margin-top: 14px; font-size: 14px; color: var(--muted); }
  .go { margin-top: 18px; color: #fff; }
  .dots::after { content: '…'; animation: dots 1.4s steps(4) infinite; }
  @keyframes dots { 0% { content: ''; } 25% { content: '.'; } 50% { content: '..'; } 75% { content: '…'; } }
</style>
