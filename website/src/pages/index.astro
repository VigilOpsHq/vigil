---
import Marketing from '../layouts/Marketing.astro';
import Terminal from '../components/Terminal.astro';
import Architecture from '../components/Architecture.astro';
import { site } from '../data/site';

const worksWith = ['Docker', 'Docker Compose', 'PostgreSQL', 'MySQL', 'MariaDB', 'MongoDB', 'Telegram', 'S3-compatible storage'];

const checks = [
  ['containers', 'exited, unhealthy, restarting in a loop'],
  ['disk', 'usage against a threshold you set'],
  ['memory', 'free memory and swap'],
  ['nginx', 'process, config test, certificate expiry'],
  ['health URLs', 'each one mapped to the container behind it'],
];

const capabilities = [
  {
    name: 'Auto-fixes',
    body: 'Restarts containers that exited. Prunes images when the disk passes your threshold. A container that keeps crashing is escalated instead of restarted again.',
    href: '/docs/guides/auto-fixes/',
  },
  {
    name: 'Backups',
    body: 'Reads the database, user and password out of the container, dumps it, gzips it, and copies it off the server. Hourly, daily or weekly.',
    href: '/docs/guides/backups/',
  },
  {
    name: 'Restores',
    body: 'Restore into the same container or a different one, with a safety backup taken first. Postgres targets are emptied before the dump is loaded.',
    href: '/docs/guides/backups/#restoring',
  },
  {
    name: 'Deploys',
    body: 'Pull the new image, restart the service, wait for the health check, roll back if it fails. Trigger it from Telegram, the CLI, or a webhook in CI.',
    href: '/docs/guides/deploys/',
  },
  {
    name: 'Telegram',
    body: 'Status, backups, restores, deploys and updates from your phone. Anything risky waits for a tap, and is denied after 10 minutes.',
    href: '/docs/reference/telegram/',
  },
  {
    name: 'Allowlist',
    body: 'Every automatic command, including anything the AI suggests, has to match a short list. Volumes are never pruned. Everything lands in an audit log.',
    href: '/docs/guides/auto-fixes/#command-allowlist',
  },
];

const auditLog = [
  { time: '03:12:04', kind: 'rule', text: 'worker exited (code 137)', action: 'docker restart worker', result: 'success' },
  { time: '03:12:09', kind: 'rule', text: 'worker healthy again', action: '', result: 'ok' },
  { time: '09:40:31', kind: 'rule', text: 'disk at 87% (threshold 85%)', action: 'docker image prune -f', result: 'success' },
  { time: '11:02:55', kind: 'ai', text: 'api health check timing out', action: 'docker restart api', result: 'awaiting approval' },
];

const allowlist = [
  'docker restart <container>',
  'docker image prune -f',
  'docker system prune -f --volumes=false',
  'systemctl restart nginx',
  'systemctl reload nginx',
];
---

<Marketing
  title="VigilOps: ops automation for a single Docker server"
  description="VigilOps is an open-source agent for Docker servers. It restarts what breaks, backs up your databases, deploys your apps, and asks before doing anything risky, from your terminal or Telegram."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Ops automation for a single Docker server.</h1>
        <p class="lead">
          VigilOps runs as one container beside your apps. It checks them every 60 seconds, restarts what breaks, backs up
          your databases, and asks you on Telegram before it does anything risky.
        </p>
        <div class="copy-cmd install" data-copy={site.install}>
          <code><span class="prompt">$ </span>{site.install}</code>
          <button type="button">Copy</button>
        </div>
        <div class="cta">
          <a class="btn btn-primary" href="/docs/install/">Installation guide</a>
          <a class="btn btn-secondary" href={site.github}>Source on GitHub</a>
        </div>
        <p class="meta">MIT licensed · Ubuntu and Debian · amd64 and arm64 · no account needed</p>
      </div>
      <div class="hero-visual">
        <Terminal />
      </div>
    </div>
  </section>

  <!-- WORKS WITH -->
  <section class="works" aria-label="Works with">
    <div class="container works-inner">
      <span class="works-label">Works with</span>
      <ul>{worksWith.map((w) => <li>{w}</li>)}</ul>
    </div>
  </section>

  <!-- ARCHITECTURE -->
  <section class="section" id="product">
    <div class="container arch-grid">
      <div class="arch-copy" data-reveal>
        <h2>One container, talking to Docker.</h2>
        <p>
          No cluster, no agent fleet, no per-app configuration. VigilOps reads the Docker socket, so it already knows what
          you're running. The only state it keeps is on your disk.
        </p>
        <div class="checks">
          <p class="checks-head">Every 60 seconds it checks</p>
          <dl>
            {checks.map(([name, detail]) => (
              <div>
                <dt>{name}</dt>
                <dd>{detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
      <div class="arch-wrap" data-reveal>
        <Architecture />
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>What it does</h2>
      </div>
      <div class="caps" data-reveal>
        {capabilities.map((c) => (
          <a class="cap" href={c.href}>
            <h3>{c.name}</h3>
            <p>{c.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT YOU SEE -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>What you see</h2>
        <p>
          Every action is written to an audit log on the server, and the ones worth knowing about reach you on Telegram.
        </p>
      </div>

      <div class="evidence">
        <div class="panel log" data-reveal>
          <div class="panel-head">
            <span>logs/audit.jsonl</span>
            <span class="live"><i></i>live</span>
          </div>
          <ul>
            {auditLog.map((e, i) => (
              <li style={`--d:${i * 0.35}s`}>
                <span class="time">{e.time}</span>
                <span class={`kind kind-${e.kind}`}>{e.kind}</span>
                <span class="event">
                  {e.text}
                  {e.action && <code>{e.action}</code>}
                </span>
                <span class={`result ${e.result === 'awaiting approval' ? 'pending' : ''}`}>{e.result}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="chat" data-reveal>
          <div class="chat-head">
            <span class="avatar">V</span>
            <div><strong>VigilOps · prod-01</strong><span>bot</span></div>
          </div>
          <div class="chat-body">
            <div class="msg" style="--d:.1s">
              <strong>🔧 Auto-fix:</strong> Container(s) down, restarting: <code>worker</code>
              <span class="t">03:12</span>
            </div>
            <div class="msg" style="--d:.5s">✅ <code>docker restart worker</code> — done<span class="t">03:12</span></div>
            <div class="msg" style="--d:.9s">
              <strong>✅ Backup done:</strong> api-postgres<br />Size: 156.1 MB in 35s<br />Copies: server disk, storage
              <span class="t">02:00</span>
            </div>
            <div class="msg" style="--d:1.3s">
              <strong>⚠️ Approval Required</strong><br />AI suggests: api health check timing out after deploy.<br />
              <code>docker restart api</code>
              <div class="buttons"><span>✅ Approve</span><span>❌ Deny</span></div>
              <span class="t">11:02</span>
            </div>
            <div class="msg me" style="--d:1.7s">/backups api-postgres<span class="t">11:04</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BACKUPS -->
  <section class="section section-soft">
    <div class="container feature">
      <div class="feature-copy" data-reveal>
        <h2>Backups you can restore.</h2>
        <p>
          Restoring is one command. It takes a safety copy of the target database first, so a restore you didn't mean to run
          is not the end of the story.
        </p>
        <ul class="points">
          <li>Schedules set from the server or Telegram, not a config file</li>
          <li>Copies to S3-compatible storage, VigilOps Cloud, or Telegram</li>
          <li>Restore into a different container to test the dump first</li>
          <li>A message for every backup, including the ones that fail</li>
        </ul>
        <a class="more" href="/docs/guides/backups/">Backup guide <span aria-hidden="true">→</span></a>
      </div>
      <div class="panel backups" data-reveal>
        <div class="panel-head"><span>Backups · api-postgres</span><span class="badge">daily 02:00</span></div>
        <table>
          <thead>
            <tr><th>File</th><th>Size</th><th>Copies</th></tr>
          </thead>
          <tbody>
            <tr><td><code>api-postgres__api__20260917-020000.sql.gz</code></td><td>156.1 MB</td><td><span class="chip">disk</span><span class="chip">S3</span></td></tr>
            <tr><td><code>api-postgres__api__20260916-020000.sql.gz</code></td><td>155.8 MB</td><td><span class="chip">disk</span><span class="chip">S3</span></td></tr>
            <tr><td><code>api-postgres__api__20260915-020000.sql.gz</code></td><td>155.2 MB</td><td><span class="chip">disk</span><span class="chip">S3</span></td></tr>
            <tr class="muted"><td><code>api-postgres__api__20260914-101500_pre-restore.sql.gz</code></td><td>154.9 MB</td><td><span class="chip">disk</span></td></tr>
          </tbody>
        </table>
        <div class="panel-foot">
          <code>vigil restore api-postgres__api__20260917-020000.sql.gz</code>
        </div>
      </div>
    </div>
  </section>

  <!-- ALLOWLIST -->
  <section class="section">
    <div class="container feature reverse">
      <div class="feature-copy" data-reveal>
        <h2>It can only run what you allow.</h2>
        <p>
          Every command VigilOps runs on its own has to match this list, whether a rule or the AI proposed it. Anything
          else is blocked and written to the audit log.
        </p>
        <ul class="points">
          <li>Volumes are never pruned</li>
          <li>Updates install only after someone approves them</li>
          <li>Backups, restores and deploys run only when asked or scheduled</li>
        </ul>
        <a class="more" href="/docs/guides/auto-fixes/#command-allowlist">How the allowlist works <span aria-hidden="true">→</span></a>
      </div>
      <div class="panel code" data-reveal>
        <div class="panel-head"><span>src/executor/index.ts</span><span class="badge">allowlist</span></div>
        <pre><code>{allowlist.map((c) => <span class="ok-line"><span class="check">✓</span> {c}{'\n'}</span>)}<span class="no-line"><span class="cross">✗</span> rm -rf /var/lib/postgresql   <span class="blocked">blocked</span>{'\n'}</span><span class="no-line"><span class="cross">✗</span> docker volume prune -f      <span class="blocked">blocked</span></span></code></pre>
      </div>
    </div>
  </section>

  <!-- INSTALL / CLOUD -->
  <section class="band">
    <div class="container band-grid" data-reveal>
      <div class="band-main">
        <h2>Install it on the server you already have.</h2>
        <p>One command, about a minute, no account. Every feature above is in the MIT-licensed agent.</p>
        <div class="copy-cmd" data-copy={site.install}>
          <code><span class="prompt">$ </span>{site.install}</code>
          <button type="button">Copy</button>
        </div>
        <div class="cta">
          <a class="btn btn-dark" href="/docs/install/">Installation guide</a>
          <a class="btn btn-outline-light" href="/docs/">Documentation</a>
        </div>
      </div>
      <aside class="band-aside">
        <h3>VigilOps Cloud</h3>
        <p>
          If you'd rather not run your own off-server storage: managed backup storage, a dashboard for every backup, and
          alerts when a server or a scheduled backup goes quiet. From $19 a month.
        </p>
        <a class="more light" href="/pricing/">Plans and pricing <span aria-hidden="true">→</span></a>
        <a class="more light" href="/status/">Cloud status <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>
</Marketing>

<style>
  /* hero */
  .hero { padding: 48px 0 56px; border-bottom: 1px solid var(--line); background:
    linear-gradient(to bottom, #fff 0%, #fff 60%, var(--bg-soft) 100%); }
  .hero-grid { display: grid; gap: 40px; align-items: center; }
  .hero-grid > * { min-width: 0; }
  h1 { font-size: clamp(34px, 5.2vw, 56px); letter-spacing: -0.03em; max-width: 14ch; }
  .lead { font-size: clamp(17px, 2vw, 19px); color: var(--ink-2); margin-top: 20px; max-width: 560px; }
  .install { margin-top: 28px; max-width: 560px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
  .meta { color: var(--muted); font-size: 13px; margin-top: 18px; font-family: var(--mono); }
  @media (min-width: 1000px) {
    .hero { padding: 76px 0 84px; }
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 56px; }
  }

  /* works with */
  .works { border-bottom: 1px solid var(--line); background: var(--bg-soft); }
  .works-inner { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 24px; padding-top: 18px; padding-bottom: 18px; }
  .works-label { font: 500 13px/1 var(--mono); color: var(--muted); }
  .works ul { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0; padding: 0; }
  .works li { font: 500 13px/1 var(--mono); color: var(--ink-2); }

  /* architecture */
  .arch-grid { display: grid; gap: 44px; align-items: center; }
  .arch-grid > * { min-width: 0; }
  .arch-copy h2 { font-size: clamp(26px, 3.4vw, 36px); }
  .arch-copy > p { color: var(--ink-2); font-size: 17px; margin-top: 16px; }
  .checks { margin: 28px 0 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .checks-head { background: var(--bg-soft); border-bottom: 1px solid var(--line); padding: 10px 16px; font: 500 12px/1 var(--mono); text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  .checks dl { margin: 0; display: grid; gap: 1px; background: var(--line); }
  .checks dl > div { display: flex; flex-wrap: wrap; gap: 4px 14px; background: #fff; padding: 11px 16px; }
  .checks dt { font: 500 14px var(--mono); color: var(--ink); min-width: 110px; }
  .checks dd { margin: 0; color: var(--muted); font-size: 14px; }
  @media (min-width: 1000px) { .arch-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 64px; } }

  /* capabilities */
  .caps { display: grid; gap: 1px; margin-top: 36px; background: var(--line); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .cap { display: block; background: #fff; padding: 26px 24px; text-decoration: none; transition: background-color .15s; }
  .cap:hover { background: #fbfdfe; }
  .cap h3 { font-size: 16px; font-family: var(--mono); font-weight: 600; }
  .cap:hover h3 { color: var(--brand); }
  .cap p { color: var(--muted); margin-top: 10px; font-size: 15px; }
  @media (min-width: 700px) { .caps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .caps { grid-template-columns: repeat(3, 1fr); } }

  /* evidence */
  .evidence { display: grid; gap: 28px; margin-top: 40px; align-items: start; }
  .evidence > * { min-width: 0; }
  @media (min-width: 1000px) { .evidence { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 40px; } }

  /* feature rows */
  .feature { display: grid; gap: 40px; align-items: center; }
  .feature > * { min-width: 0; }
  .feature-copy h2 { font-size: clamp(26px, 3.4vw, 36px); }
  .feature-copy > p { color: var(--ink-2); font-size: 17px; margin-top: 16px; }
  .points { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 10px; }
  .points li { position: relative; padding-left: 26px; color: var(--ink-2); }
  .points li::before { content: ''; position: absolute; left: 2px; top: 9px; width: 12px; height: 7px; border-left: 2px solid var(--brand); border-bottom: 2px solid var(--brand); transform: rotate(-45deg); }
  .points code, .feature-copy code { font-size: 14px; background: var(--bg-soft); border: 1px solid var(--line); padding: 1px 6px; border-radius: 4px; }
  .more { display: inline-flex; gap: 6px; margin-top: 24px; color: var(--brand); font-weight: 600; text-decoration: none; }
  .more:hover { text-decoration: underline; }
  @media (min-width: 1000px) {
    .feature { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 72px; }
    .feature.reverse .feature-copy { order: 2; }
  }

  /* panels */
  .panel { background: #fff; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; box-shadow: 0 1px 2px rgba(11,27,43,.04), 0 16px 40px -24px rgba(11,27,43,.25); }
  .panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); font: 500 13px/1 var(--mono); color: var(--muted); background: var(--bg-soft); }
  .live { display: inline-flex; align-items: center; gap: 6px; color: var(--ok); }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); animation: livepulse 1.6s ease-in-out infinite; }
  @keyframes livepulse { 50% { opacity: .3; } }
  .badge { background: var(--brand-soft); color: var(--brand); padding: 4px 8px; border-radius: 4px; font-size: 12px; }

  .log ul { list-style: none; margin: 0; padding: 6px 0; }
  .log li {
    display: grid; grid-template-columns: auto auto 1fr; gap: 6px 12px; align-items: baseline;
    padding: 12px 16px; border-bottom: 1px solid var(--line); font-size: 14px;
  }
  .log li:last-child { border-bottom: 0; }
  .log .time { font: 13px var(--mono); color: var(--muted); }
  .kind { font: 600 11px/1 var(--mono); text-transform: uppercase; padding: 4px 6px; border-radius: 4px; }
  .kind-rule { background: #eef2f6; color: var(--ink-2); }
  .kind-ai { background: #fdf0e8; color: #b4501f; }
  .event { color: var(--ink); min-width: 0; }
  .event code { display: block; margin-top: 4px; font-size: 13px; color: var(--ink-2); overflow-wrap: anywhere; }
  .result { grid-column: 3; font: 12px var(--mono); color: var(--ok); }
  .result.pending { color: var(--signal); }
  @media (min-width: 560px) {
    .log li { grid-template-columns: auto auto 1fr auto; }
    .result { grid-column: auto; }
  }
  .log.is-visible li { animation: rowin .5s ease both; animation-delay: var(--d); }
  @keyframes rowin { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .backups { overflow-x: auto; }
  .backups table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 420px; table-layout: fixed; }
  .backups th:nth-child(2), .backups td:nth-child(2) { width: 92px; }
  .backups th:nth-child(3), .backups td:nth-child(3) { width: 112px; }
  .backups th { text-align: left; font: 600 12px var(--mono); color: var(--muted); padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .backups td { padding: 12px 16px; border-bottom: 1px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .backups td code { font-size: 12.5px; }
  .backups tr.muted td { color: var(--muted); }
  .chip { display: inline-block; font: 600 11px/1 var(--mono); padding: 4px 6px; border-radius: 4px; background: var(--brand-soft); color: var(--brand); margin-right: 6px; }
  .panel-foot { padding: 14px 16px; background: var(--term); color: var(--term-text); font-size: 13px; overflow-x: auto; white-space: nowrap; }
  .panel-foot code::before { content: '$ '; color: #7ee2b8; }

  .code pre { margin: 0; padding: 18px; background: var(--term); color: var(--term-text); font-size: 13.5px; line-height: 1.8; overflow-x: auto; }
  .check { color: #7ee2b8; }
  .cross { color: #ff8a65; }
  .no-line { color: #7d8b99; }
  .blocked { color: #ff8a65; font-size: 12px; }

  /* chat */
  .chat { background: #dfe8ee; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; max-width: 460px; width: 100%; justify-self: center; box-shadow: 0 16px 40px -24px rgba(11,27,43,.3); }
  .chat-head { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: #fff; border-bottom: 1px solid var(--line); }
  .chat-head strong { display: block; font-size: 15px; }
  .chat-head span { font-size: 12px; color: var(--muted); }
  .avatar { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--brand); color: #fff; font-weight: 700; }
  .chat-body { display: grid; gap: 8px; padding: 16px; justify-items: start; }
  .msg { position: relative; background: #fff; border-radius: 12px 12px 12px 4px; padding: 9px 12px 20px; font-size: 14px; line-height: 1.5; max-width: 92%; box-shadow: 0 1px 1px rgba(0,0,0,.06); }
  .msg code { font-size: 12.5px; background: #f1f4f7; padding: 1px 5px; border-radius: 4px; }
  .msg.me { justify-self: end; background: #d9f7e4; border-radius: 12px 12px 4px 12px; font-family: var(--mono); font-size: 13px; }
  .t { position: absolute; right: 10px; bottom: 4px; font-size: 11px; color: #8a99a8; font-family: var(--font); }
  .buttons { display: flex; gap: 6px; margin-top: 8px; }
  .buttons span { flex: 1; text-align: center; font-size: 13px; padding: 6px 10px; background: #f1f4f7; border-radius: 6px; }
  .chat.is-visible .msg { animation: rowin .45s ease both; animation-delay: var(--d); }

  /* install band */
  .band { background: var(--navy); color: #fff; padding: 72px 0; }
  .band-grid { display: grid; gap: 40px; align-items: start; }
  .band-grid > * { min-width: 0; }
  .band h2 { font-size: clamp(26px, 3.6vw, 36px); max-width: 18ch; }
  .band-main > p { color: #a9b8c7; font-size: 17px; margin-top: 14px; max-width: 52ch; }
  .band .copy-cmd { margin-top: 24px; border-color: #26384b; max-width: 560px; }
  .band .cta { margin-top: 16px; }
  .band-aside { border-top: 1px solid #24374a; padding-top: 24px; }
  .band-aside h3 { font-size: 16px; font-family: var(--mono); font-weight: 600; }
  .band-aside p { color: #a9b8c7; margin-top: 12px; font-size: 15px; }
  .more.light { color: #7ee2b8; margin-top: 16px; margin-right: 24px; }
  @media (min-width: 1000px) {
    .band-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: 64px; }
    .band-aside { border-top: 0; border-left: 1px solid #24374a; padding: 0 0 0 40px; }
  }
</style>
