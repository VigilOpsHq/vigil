---
import Marketing from './Marketing.astro';
import { company, hasPlaceholders } from '../data/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<Marketing title={`${title} · VigilOps`} description={description}>
  <article class="legal">
    <div class="container narrow">
      {hasPlaceholders && (
        <p class="draft" role="note">
          Draft: some business details on this page have not been filled in yet.
        </p>
      )}
      <h1>{title}</h1>
      <p class="updated">Last updated {company.legalUpdated}</p>
      <div class="body"><slot /></div>
    </div>
  </article>
</Marketing>

<style>
  .legal { padding: 64px 0 96px; }
  .narrow { max-width: 760px; }
  .draft { background: #fdf0e8; color: #8a3d17; border: 1px solid #f6cfb6; padding: 10px 14px; border-radius: 8px; font-size: 14px; margin-bottom: 28px; }
  h1 { font-size: clamp(32px, 5vw, 44px); }
  .updated { color: var(--muted); margin-top: 10px; font-size: 14px; }
  .body { margin-top: 36px; color: var(--ink-2); font-size: 16.5px; }
  .body :global(h2) { font-size: 22px; color: var(--ink); margin: 36px 0 12px; }
  .body :global(p), .body :global(ul) { margin: 0 0 14px; }
  .body :global(ul) { padding-left: 22px; }
  .body :global(li) { margin-bottom: 6px; }
  .body :global(a) { color: var(--brand); }
</style>
