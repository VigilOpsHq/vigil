{
  "name": "vigilops",
  "version": "1.1.4",
  "description": "AI-powered DevOps agent — monitors, heals, and escalates",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dev:mcp": "ts-node src/mcp/index.ts",
    "dev:cli": "ts-node src/cli/index.ts",
    "dev:api": "ts-node src/api/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp/index.js",
    "start:mcp:http": "MCP_MODE=http node dist/mcp/index.js",
    "start:mcp:stdio": "MCP_MODE=stdio node dist/mcp/index.js",
    "start:cli": "node dist/cli/index.js",
    "start:api": "node dist/api/server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-telegram-bot-api": "^0.66.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
