# ── Telegram (optional when connected to VigilOps Cloud) ──
# Your own bot from @BotFather, for commands and alerts from this server.
# Use a different bot token on each server (two servers polling one bot causes 409 errors).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI escalation (optional) ──────────────────────────
# Any provider with an OpenAI-compatible /chat/completions endpoint: OpenAI,
# DeepSeek, Groq, Together, OpenRouter, Mistral, or a local Ollama or vLLM.
# Leave the key empty and VigilOps runs on its rules alone, with no AI calls.
#
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   DeepSeek    AI_BASE_URL=https://api.deepseek.com         AI_MODEL=deepseek-chat
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=anthropic/claude-sonnet-4
#   Ollama      AI_BASE_URL=http://localhost:11434/v1       AI_MODEL=llama3.2   (no key needed)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ── Version ─────────────────────────────────────────────────
# latest | 1.2 (1.2.x fixes only) | 1.2.3 (exact)
VIGIL_TAG=latest
# Daily check for new releases, announced on Telegram with an Update button
VIGIL_UPDATE_CHECK=true

# ── Deploy webhook (optional) ───────────────────────────────
# Only needed to trigger deploys from CI. Random string, e.g.: openssl rand -hex 32
VIGIL_WEBHOOK_SECRET=

# ── Monitoring (optional) ───────────────────────────────────
POLL_INTERVAL_SECONDS=60
HEALTH_CHECK_URLS=
# HEALTH_CHECK_CONTAINER_MAP=https://api.example.com/health:my-api
EXCLUDED_CONTAINERS=
DISK_ALERT_PERCENT=85
MEMORY_ALERT_PERCENT=90

# ── Database backups (optional) ─────────────────────────────
BACKUP_KEEP_DAYS=7
BACKUP_SEND_TO_TELEGRAM=true
# Off-server copies in S3-compatible storage (Contabo Object Storage, S3, B2, R2)
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ── VigilOps Cloud (Pro and Team) ───────────────────────────
# Token from https://vigilops.cloud/app → Add server. Or run: vigil cloud connect <token>
VIGIL_CLOUD_TOKEN=
